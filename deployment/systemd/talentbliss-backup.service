[Unit]
Description=Back up the TalentBliss PostgreSQL database
After=postgresql.service

[Service]
Type=oneshot
User=talentbliss
Group=talentbliss
EnvironmentFile=/etc/talentbliss/api.env
ExecStart=/opt/talentbliss/current/deployment/scripts/backup-postgres.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/talentbliss
